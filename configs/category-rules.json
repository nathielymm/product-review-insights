{
  "version": "title_rules_v2_accessory_and_kit_review",
  "policy": "Match official catalog title only. No match or multiple matches remain unresolved. Rules are not official subcategories.",
  "rules": [
    {
      "id": "shampoo",
      "label_pt": "Shampoos",
      "include": "\\bshampoo\\b",
      "exclude": "\\b(dry shampoo|shampoo brush|shampoo bowl|shampoo cap|empty|dispenser|pump only|beard|travel bottles?|refillable|cosmetic tube)\\b"
    },
    {
      "id": "dry_shampoo",
      "label_pt": "Shampoos a seco",
      "include": "\\bdry shampoo\\b"
    },
    {
      "id": "conditioner",
      "label_pt": "Condicionadores",
      "include": "\\bconditioner\\b",
      "exclude": "\\b(air conditioner|water conditioner|dispenser|empty|beard|mustache|moustache)\\b"
    },
    {
      "id": "hair_mask",
      "label_pt": "Máscaras capilares",
      "include": "\\b(hair mask|conditioning mask|hair masque)\\b"
    },
    {
      "id": "hair_oil_serum",
      "label_pt": "Óleos e séruns capilares",
      "include": "\\b(hair oil|hair serum|hair growth oil|hair treatment oil)\\b"
    },
    {
      "id": "hair_color",
      "label_pt": "Coloração e retoque de cabelos",

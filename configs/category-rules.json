    },
    {
      "id": "hair_dryer",
      "label_pt": "Secadores de cabelo",
      "include": "\\b(hair dryer|blow dryer|hairdryer)\\b",
      "exclude": "\\b(diffuser|holder|stand|attachment|nozzle|bonnet|cap)\\b"
    },
    {
      "id": "hair_diffuser",
      "label_pt": "Difusores para secador",
      "include": "\\b(hair diffuser|diffuser.*hair|diffuser.*dryer)\\b"
    },
    {
      "id": "hair_straightener",
      "label_pt": "Pranchas e alisadores",
